# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                 # server-only, never exposed to client

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails that get admin access (bootstrap before setting
# profiles.is_admin in the DB). Optional.
ADMIN_EMAILS=

# ---- Instagram API with Instagram Login ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=                      # server-only
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# 32-byte (64 hex chars) key for encrypting stored IG tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Shared secret protecting the Vercel cron sync endpoint.
CRON_SECRET=

# ---- Email notifications (Resend) — optional ----
# Without these, the app runs fine and simply skips emails.
RESEND_API_KEY=
EMAIL_FROM=Muabox <notifications@yourdomain.com>   # must be a Resend-verified sender

# ---- Payments (Razorpay, India/INR) — optional ----
# Without these, the Pay button returns "payments unavailable" and nothing breaks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                         # server-only, never exposed
RAZORPAY_WEBHOOK_SECRET=                      # set the same value in the Razorpay webhook config
NEXT_PUBLIC_RAZORPAY_KEY_ID=                  # same as RAZORPAY_KEY_ID; used by Checkout in the browser
# Platform commission withheld from each artist payout (percent). Default 10.
PLATFORM_FEE_PERCENT=10

# ---- WhatsApp notifications (Twilio) — optional ----
# Without these, WhatsApp pings are skipped. Production WABA needs approved templates.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Distributed rate limiting (Upstash Redis) — optional ----
# Without these, rate limits fall back to a per-instance in-memory limiter
# (fine as a burst guard). Set both for correct GLOBAL limits on serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
